[Unit]
Description=ZohaOnline Discovery 2.7.0 Gunicorn
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=zohaonline
Group=www-data
WorkingDirectory=/opt/zohaonline
EnvironmentFile=/opt/zohaonline/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/zohaonline/.venv/bin/gunicorn \
    --workers 3 \
    --threads 2 \
    --bind 127.0.0.1:18123 \
    --timeout 180 \
    --keep-alive 5 \
    --max-requests 1200 \
    --max-requests-jitter 120 \
    --access-logfile - \
    --error-logfile - \
    zoha.wsgi:application
Restart=always
RestartSec=4
KillSignal=SIGQUIT
TimeoutStopSec=30
PrivateTmp=true
NoNewPrivileges=true
UMask=0027

[Install]
WantedBy=multi-user.target
