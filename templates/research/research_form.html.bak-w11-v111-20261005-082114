(function bootZohaEditor(){
 const textarea=document.getElementById('id_body'),status=document.getElementById('zohaEditorBootStatus');
 if(!textarea)return; textarea.classList.add('rich-editor');
 try{if(window.ZohaHtmlEditor&&!textarea.zohaHtmlEditor)window.ZohaHtmlEditor.create(textarea,{placeholder:'متن اصلی فیش را اینجا بنویسید یا وارد کنید…'});if(status){status.className='editor-status success';status.innerHTML='<i class="fa-solid fa-circle-check"></i> ویرایشگر آماده است';setTimeout(()=>status.remove(),1500);}}catch(e){if(status){status.className='editor-status error';status.textContent='ویرایشگر پیشرفته فعال نشد؛ نوشتن در فیلد اصلی همچنان ممکن است.';}}
