ZohaFishForm.init({formId:'fishForm',topics:JSON.parse(document.getElementById('topic-options-data').textContent),processing:JSON.parse(document.getElementById('processing-options-data').textContent),predicates:JSON.parse(document.getElementById('predicate-options-data').textContent),jobs:JSON.parse(document.getElementById('job-options-data').textContent),countries:JSON.parse(document.getElementById('country-options-data').textContent),cities:JSON.parse(document.getElementById('city-options-data').textContent),analyses:JSON.parse(JSON.parse(document.getElementById('existing-analyses-data').textContent)||'[]'),audiences:JSON.parse(JSON.parse(document.getElementById('existing-audiences-data').textContent)||'[]')});
