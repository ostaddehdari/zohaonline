const seoBtn=document.getElementById('suggestSeoTags');
seoBtn?.addEventListener('click', async()=>{const body=document.getElementById('id_body')?.value||'';seoBtn.disabled=true;const old=seoBtn.innerHTML;seoBtn.innerHTML='<i class="fa-solid fa-spinner fa-spin"></i> در حال پیشنهاد…';try{const fd=new FormData();fd.append('body',body);fd.append('csrfmiddlewaretoken',document.querySelector('[name=csrfmiddlewaretoken]').value);const r=await fetch('{% url "api_seo_suggest" %}',{method:'POST',body:fd,headers:{'X-Requested-With':'XMLHttpRequest'}});const j=await r.json();if(!r.ok||!j.ok)throw new Error(j.error||'خطا');document.getElementById('id_seo_tags_text').value=(j.tags||[]).join('، ');document.getElementById('id_seo_tags_text').dispatchEvent(new Event('change',{bubbles:true}));}catch(e){alert('پیشنهاد برچسب انجام نشد: '+e.message)}finally{seoBtn.disabled=false;seoBtn.innerHTML=old;}});
const imageBtn=document.getElementById('generateFeaturedImage');
